# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# PyInstaller intermediate (auto-regenerated by build-daemon.sh)
Daemon/lociighostd.spec
Daemon/build/
Daemon/dist/

# Swift / Xcode
App/.build/
App/.swiftpm/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/

# Icon build artefacts (regenerated by generate-icon.swift from
# Resources/AppIcon-Master.pdf — that master IS committed, the
# rasterised PNGs are intermediate)
App/Sources/LociiGhost/Resources/AppIcon.iconset/

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Logs / sockets / runtime artifacts
*.log
*.sock

# Notarisation logs (contain submission UUIDs; not secret, but
# noisy and not useful in source history)
dist/notarytool.log

# Local secret env files — never commit. Apple-ID app-specific
# passwords are in keychain (via notarytool store-credentials),
# but anything users might put in a local .env should stay local.
.env
.env.local
.envrc
